# This file is a template. Keep real values in a private host-only file, never in Git.
# Render uses these two values to select and authenticate the paid sandbox workspace.
RENDER_API_KEY=rnd_replace_me
RENDER_WORKSPACE_ID=tea_replace_me

# The coding model is called on the host. The default provider is Mistral.
MISTRAL_API_KEY=replace_me
# This model was verified through the direct Mistral API; select one available in your account.
VIBE_RENDER_MODEL=mistral-medium-3-5

# To use Mistral's Devstral through OpenRouter, select --provider openrouter at installation.
# OPENROUTER_API_KEY=replace_me
# For OpenRouter, also change VIBE_RENDER_MODEL above to mistralai/devstral-2512.

# Optional: restore a trusted, already prepared dependency snapshot. It must still be available.
# VIBE_RENDER_SNAPSHOT=snp_replace_me
